generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum MealStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String          @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  profiles     HealthProfile[]
}

model HealthProfile {
  id              String        @id @default(cuid())
  userId          String?       @unique
  displayName     String        @default("林同学")
  goal            String        @default("温和减脂")
  dietaryNotes    String        @default("") @db.VarChar(1000)
  data            Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals           MealRecord[]
  planVersions    PlanVersion[]
  planAdjustments PlanAdjustment[]
  feedback        Feedback[]
  weightRecords   WeightRecord[]
}

model MealRecord {
  id              String       @id @default(cuid())
  profileId       String
  eatenAt         DateTime     @default(now())
  title           String
  mealType        MealType     @default(OTHER)
  items           Json
  estimatedKcal   Int?
  lowerKcal       Int?
  upperKcal       Int?
  proteinG        Float?
  carbsG          Float?
  fatG            Float?
  notes           String       @default("") @db.VarChar(1000)
  status          MealStatus   @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  profile         HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, eatenAt])
  @@index([status, createdAt])
}

model PlanVersion {
  id              String        @id @default(cuid())
  profileId       String
  version         Int
  plan            Json
  activeAt        DateTime?
  createdAt       DateTime      @default(now())
  profile         HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, version])
  @@index([profileId, activeAt])
}

model PlanAdjustment {
  id          String        @id @default(cuid())
  profileId   String
  dayKey      String        @db.VarChar(10)
  nextDayKey  String        @db.VarChar(10)
  baseVersion Int
  adjustment  Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  profile     HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dayKey])
  @@index([profileId, updatedAt])
}

model Feedback {
  id          String        @id @default(cuid())
  profileId   String
  topic       String
  rating      Int?
  note        String        @default("") @db.VarChar(1000)
  createdAt   DateTime      @default(now())
  profile     HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model WeightRecord {
  id        String        @id @default(cuid())
  profileId String
  dateKey   String        @db.VarChar(10)
  kg        Float
  note      String        @default("") @db.VarChar(100)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  profile   HealthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dateKey])
  @@index([profileId, dateKey])
}

model KnowledgeChunk {
  id          String    @id @default(cuid())
  title       String
  source      String    @db.VarChar(512)
  content     String    @db.LongText
  embedding   Json?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([source])
}
