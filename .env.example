# Copy to .env.local for development. Never commit real credentials.
DATABASE_URL="mysql://root:password@127.0.0.1:3306/zhiyang"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# OpenAI 兼容服务的 Base URL，留空表示官方接口（DeepSeek 示例：https://api.deepseek.com/v1）
OPENAI_BASE_URL=""
# 图片餐食识别所用的多模态模型（需支持图片输入）
VISION_MODEL=""
# 视觉模型可单独使用不同的服务；留空则复用 OPENAI_*
VISION_API_KEY=""
VISION_BASE_URL=""
# 餐食识别专用模型：可与通用聊天模型分开；留空则沿用 VISION_MODEL / OPENAI_MODEL
MEAL_VISION_MODEL="qwen3.8-flash"
# 餐食结构化分析使用的快速文本模型；留空沿用 OPENAI_MODEL
MEAL_ANALYSIS_MODEL="deepseek-v4.1-flash"
# 对支持 enable_thinking 的兼容服务关闭思考，显著降低两次调用的延迟
MEAL_DISABLE_THINKING="true"

# RAG 向量化需要独立凭据（DeepSeek 等聊天模型通常不提供 embeddings）
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL="text-embedding-3-small"
# Demo profile is available outside production. Defaults to on in production
# unless DEMO_MODE="false" (which re-enables the authentication gate).
DEMO_MODE="true"
